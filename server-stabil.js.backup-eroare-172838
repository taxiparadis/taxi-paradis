function trimiteOferta(idComanda) {

    const oferta = listaOferte[idComanda];

    if (!oferta) return;

    const comanda = comenzi[idComanda];

    if (!comanda) return;

    // =====================================================
    // FUNCTIE: TRIMITE COMANDA UNUI SOFER
    // =====================================================

    function trimiteLaSofer(indicativ, motiv) {

        const socketId = socketSoferi[indicativ];

        console.log(
            "DEBUG TRIMITERE OFERTA:",
            indicativ,
            "SOCKET:",
            socketId
        );

        if (!socketId) {

            console.log(
                "SOFER FARA SOCKET:",
                indicativ
            );

            return false;
        }

        console.log(
            "================================"
        );

        console.log(
            "TRIMIT COMANDA:",
            idComanda
        );

        console.log(
            "SOFER:",
            indicativ
        );

        console.log(
            "MOTIV:",
            motiv
        );

        console.log(
            "================================"
        );

        io.to(socketId).emit("comanda_noua", {
            id: idComanda,
            plecare: comanda.plecare,
            destinatie: comanda.destinatie
        });

        return true;
    }


    // =====================================================
    // CAUTAM DIN NOU PRIMA STATIE
    // =====================================================

    function cautaDinPrimaStatie() {

        const primaStatie = oferta.primaStatie;

        if (!primaStatie) {

            console.log(
                "NU EXISTA PRIMA STATIE PENTRU COMANDA:",
                idComanda
            );

            return null;
        }

        console.log(
            "VERIFIC DIN NOU PRIMA STATIE:",
            primaStatie
        );

        if (!randStatii[primaStatie]) {
            return null;
        }

        for (const sofer of randStatii[primaStatie]) {

            // Daca soferul a fost deja trimis din statie
            // pentru aceasta comanda, nu il repetam
            if (
                oferta.soferiIncercati &&
                oferta.soferiIncercati.includes(
                    String(sofer)
                )
            ) {
                continue;
            }

            // Daca are comanda activa, nu il alegem
            let areComandaActiva = false;

            for (const id in comenzi) {

                const c = comenzi[id];

                if (!c) continue;

                if (
                    String(c.indicativ) === String(sofer) &&
                    (
                        c.status === "ACCEPTATA" ||
                        c.status === "LA_CLIENT" ||
                        c.status === "IN_CURSA"
                    )
                ) {
                    areComandaActiva = true;
                    break;
                }
            }

            if (areComandaActiva) continue;

            console.log(
                "SOFER GASIT DIN NOU IN PRIMA STATIE:",
                sofer
            );

            return String(sofer);
        }

        return null;
    }


    // =====================================================
    // CAUTAM CEL MAI APROPIAT SOFER LIBER
    // =====================================================

    function cautaSoferLiber() {

        console.log("DEBUG CAUTARE LIBER:", oferta);

        const primaStatie = oferta.primaStatie;

        if (!primaStatie) return null;

        const coordStatie = statii[primaStatie];

        if (!coordStatie) {

            console.log(
                "NU AM COORDONATE PENTRU PRIMA STATIE:",
                primaStatie
            );

            return null;
        }

        let celMaiApropiat = null;
        let distantaMinima = Infinity;

        for (const indicativ in stareSoferi) {

            const sofer = stareSoferi[indicativ];

            if (!sofer) continue;

            // =============================================
            // NU REPETAM SOFERII DEJA INCERCATI DIN LIBER
            // =============================================

            if (
                oferta.soferiLiberIncercati &&
                oferta.soferiLiberIncercati.includes(
                    String(indicativ)
                )
            ) {
                continue;
            }


            // =============================================
            // TREBUIE SA AIBA GPS
            // =============================================

            if (
                typeof sofer.lat !== "number" ||
                typeof sofer.lng !== "number" ||
                !Number.isFinite(sofer.lat) ||
                !Number.isFinite(sofer.lng)
            ) {
                continue;
            }


            // =============================================
            // NU ALEGEM SOFER AFLAT IN COADA UNEI STATII
            // =============================================

            let esteInCoada = false;

            for (const statie in randStatii) {

                if (
                    Array.isArray(randStatii[statie]) &&
                    randStatii[statie].includes(
                        String(indicativ)
                    )
                ) {
                    esteInCoada = true;
                    break;
                }
            }

            if (esteInCoada && !oferta.forteazaStatie) {
                continue;
            }


            // =============================================
            // NU ALEGEM SOFER CU CURSA ACTIVA
            // =============================================

            let areComandaActiva = false;

            for (const id in comenzi) {

                const c = comenzi[id];

                if (!c) continue;

                if (
                    String(c.indicativ) === String(indicativ) &&
                    (
                        c.status === "ACCEPTATA" ||
                        c.status === "LA_CLIENT" ||
                        c.status === "IN_CURSA"
                    )
                ) {
                    areComandaActiva = true;
                    break;
                }
            }

            if (areComandaActiva) continue;


            // =============================================
            // DISTANTA GPS -> PRIMA STATIE
            // =============================================

            const d = distanta(
                sofer.lat,
                sofer.lng,
                coordStatie.lat,
                coordStatie.lng
            );

            console.log(
                "SOFER LIBER:",
                indicativ,
                "DISTANTA:",
                d
            );

            if (d < distantaMinima) {

                distantaMinima = d;
                celMaiApropiat = String(indicativ);

            }

        }

        if (celMaiApropiat) {

            console.log(
                "CEL MAI APROPIAT SOFER LIBER:",
                celMaiApropiat,
                "DISTANTA:",
                distantaMinima
            );

        }

        return celMaiApropiat;
    }


    // =====================================================
    // INITIALIZARE LISTE
    // =====================================================

    if (!Array.isArray(oferta.soferiIncercati)) {
        oferta.soferiIncercati = [];
    }

    if (!Array.isArray(oferta.soferiLiberIncercati)) {
        oferta.soferiLiberIncercati = [];
    }


    // =====================================================
    // 1. INCERCAM SOFERII NORMALI DIN TRASEU
    // =====================================================

    if (oferta.pozitie < oferta.lista.length) {

        const sofer =
            String(oferta.lista[oferta.pozitie]);

        oferta.soferiIncercati.push(sofer);

        console.log(
            "COMANDA TRIMISA LA:",
            sofer
        );

        const trimisa =
            trimiteLaSofer(
                sofer,
                "COADA STATIILOR"
            );

        if (!trimisa) {

            oferta.pozitie++;

            return trimiteOferta(idComanda);
        }


        // Dupa 15 secunde trecem la urmatorul
        setTimeout(() => {

            if (!listaOferte[idComanda]) return;

            io.to(
                socketSoferi[sofer]
            ).emit("anuleaza_comanda");

            oferta.pozitie++;

            trimiteOferta(idComanda);

        }, 15000);

        return;
    }


    // =====================================================
    // 2. NU MAI AVEM SOFERI DIN TRASEU
    //    VERIFICAM DIN NOU PRIMA STATIE
    // =====================================================

    console.log(
        "NU MAI SUNT SOFERI IN TRASEU."
    );

    const soferDinStatie =
        cautaDinPrimaStatie();

    if (soferDinStatie) {

        oferta.soferiIncercati.push(
            soferDinStatie
        );

        const trimisa =
            trimiteLaSofer(
                soferDinStatie,
                "REVERIFICARE PRIMA STATIE"
            );

        if (trimisa) {

            setTimeout(() => {

                if (!listaOferte[idComanda]) return;

                const socket =
                    socketSoferi[soferDinStatie];

                if (socket) {
                    io.to(socket).emit(
                        "anuleaza_comanda"
                    );
                }

                trimiteOferta(idComanda);

            }, 15000);

            return;
        }
    }


    // =====================================================
    // 3. CAUTAM SOFER LIBER CEL MAI APROPIAT
    // =====================================================

    console.log(
        "NU AM GASIT IN PRIMA STATIE."
    );

    console.log(
        "CAUT SOFER LIBER CEL MAI APROPIAT DE:",
        oferta.primaStatie
    );

    const soferLiber =
        cautaSoferLiber();

    if (!soferLiber) {

        console.log(
            "NU EXISTA NICIUN SOFER LIBER DISPONIBIL."
        );


        if(comenzi[idComanda]){

            comenzi[idComanda].status = "REFUZATA_DE_TOTI";

            comenzi[idComanda].mesaj =
                "Toti soferii au refuzat comanda";


            trimiteActivitate(
                "⚠️ COMANDA REFUZATA DE TOTI",
                comenzi[idComanda].plecare,
                "Comanda #" + idComanda
            );


            io.emit(
                "lista_comenzi",
                comenzi
            );

        }


        if(listaOferte[idComanda]){
            listaOferte[idComanda].inchisa = true;
        }

        delete listaOferte[idComanda];

        console.log(
            "OFERTA INCHISA DEFINITIV:",
            idComanda
        );

        return;
    }


    // Il marcam ca incercat
    oferta.soferiLiberIncercati.push(
        soferLiber
    );


    const trimisa =
        trimiteLaSofer(
            soferLiber,
            "SOFER LIBER CEL MAI APROPIAT"
        );

    if (!trimisa) {

        return trimiteOferta(idComanda);
    }


    // =====================================================
    // 4. DUPA 15 SECUNDE:
    //    - verificam iar prima statie
    //    - apoi cautam ALT SOFER LIBER
    // =====================================================

    setTimeout(() => {

        if (!listaOferte[idComanda]) return;

        const socket =
            socketSoferi[soferLiber];

        if (socket) {

            io.to(socket).emit(
                "anuleaza_comanda"
            );
        }

        console.log(
            "SOFER LIBER NU A ACCEPTAT:",
            soferLiber
        );

        console.log(
            "CAUTAM URMATORUL SOFER..."
        );

        trimiteOferta(idComanda);

    }, 15000);

}

