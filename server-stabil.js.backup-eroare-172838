app.post("/raspuns-inchidere-statie", (req, res) => {

    const indicativ = req.body.indicativ;
    const statie = req.body.statie;
    const raspuns = String(req.body.raspuns || "").toUpperCase();

    if (!indicativ || !statie || !["DA", "NU"].includes(raspuns)) {

        return res.json({
            ok: false,
            eroare: "Date invalide"
        });

    }

    if (!raspunsuriInchidereStatii[indicativ]) {
        raspunsuriInchidereStatii[indicativ] = {};
    }

    raspunsuriInchidereStatii[indicativ][statie] =
        raspuns === "DA" ? "RAMANE" : "PLEACA";

    // ========================================================
    // DA -> SOFERUL RAMANE IN STATIE
    // ========================================================

    if (raspuns === "DA") {

        console.log(
            "SOFER RAMANE:",
            indicativ,
            "STATIA:",
            statie.toUpperCase()
        );

        return res.json({
            ok: true,
            actiune: "RAMANE",
            statie: statie
        });

    }

    // ========================================================
    // NU -> SOFERUL PLEACA DIN STATIE
    // ========================================================

    if (randStatii[statie]) {

        randStatii[statie] =
            randStatii[statie].filter(s => s !== indicativ);

    }

    if (
        stareSoferi[indicativ] &&
        stareSoferi[indicativ].statie === statie
    ) {

        stareSoferi[indicativ].statie = null;

    }

    console.log(
        "SOFER PLEACA:",
        indicativ,
        "DIN STATIA:",
        statie.toUpperCase()
    );

    io.emit(
        "actualizare_statii",
        {
            statii: randStatii,
            timpuri: timpStatii
        }
    );

    return res.json({
        ok: true,
        actiune: "PLEACA",
        statie: statie
    });

});

app.post("/intra-in-statie", (req, res) => {

  const indicativ = req.body.indicativ;
  const statie = req.body.statie;

  if (!indicativ || !statie) {
    return res.json({
      ok: false,
      eroare: "Lipseste indicativul sau statia"
    });
  }

  if (!randStatii[statie]) {
    randStatii[statie] = [];
  }

  /*
   * Daca soferul era deja in alta statie,
   * il scoatem mai intai de acolo.
   */
  if (
    stareSoferi[indicativ] &&
    stareSoferi[indicativ].statie &&
    stareSoferi[indicativ].statie !== statie
  ) {

    const statieVeche = stareSoferi[indicativ].statie;

    if (randStatii[statieVeche]) {
      randStatii[statieVeche] =
        randStatii[statieVeche].filter(s => s !== indicativ);
    }

    console.log(
      "SOFER MUTAT:",
      indicativ,
      statieVeche.toUpperCase(),
      "->",
      statie.toUpperCase()
    );
  }

  /*
   * Memoram oficial ca soferul este in statie.
   */
  if (!stareSoferi[indicativ]) {
    stareSoferi[indicativ] = {
      statie: null,
      lat: null,
      lng: null
    };
  }

  stareSoferi[indicativ].statie = statie;

  /*
   * Il introducem in coada.
   */
  if (!randStatii[statie].includes(indicativ)) {
    randStatii[statie].push(indicativ);
  }

  io.emit(
    "actualizare_statii",
    {
      statii: randStatii,
      timpuri: timpStatii
    }
  );

  console.log(
    "SOFER IN STATIE:",
    indicativ,
    "STATIA:",
    statie.toUpperCase(),
    "RAND:",
    randStatii[statie].join(", ")
  );

  res.json({
    ok: true,
    statie: statie,
    rand: randStatii[statie]
  });

});


