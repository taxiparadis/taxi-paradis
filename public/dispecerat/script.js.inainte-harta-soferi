        date.adresa || "",
        date.mesaj || ""
    );

});


socket.on("istoric_activitate_live", function(lista){

    console.log("ISTORIC ACTIVITATE:", lista);

    lista.reverse().forEach(function(date){

        adaugaActivitate(
            date.titlu || "📡 EVENIMENT",
            date.adresa || "",
            date.mesaj || ""
        );

    });

});

